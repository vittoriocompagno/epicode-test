API_KEY=development-api-key
WORKER_CONCURRENCY=2
BATCH_DISPATCH_CHUNK_SIZE=500

BODY_LIMIT_BYTES=1048576
TEMPLATE_BODY_LIMIT_BYTES=131072
PREVIEW_BODY_LIMIT_BYTES=65536
BATCH_BODY_LIMIT_BYTES=32000000
PREVIEW_RATE_LIMIT_MAX=30
PREVIEW_RATE_LIMIT_WINDOW_MS=60000
GENERATE_RATE_LIMIT_MAX=60
GENERATE_RATE_LIMIT_WINDOW_MS=60000
BATCH_RATE_LIMIT_MAX=10
BATCH_RATE_LIMIT_WINDOW_MS=60000

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=certificates@localhost
